{
  "mcpServers": {
    "bch-oracle-mesh-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "Bitcoin Cash",
        "PROJECT_TICKER": "BCHORACL"
      },
      "tools": [
        {
          "name": "verify_bchoracl_invariants",
          "description": "Verifies deterministic invariants for BCH Oracle Mesh AI on Bitcoin Cash."
        },
        {
          "name": "execute_bchoracl_action",
          "description": "Executes authenticated Oracle state transition."
        }
      ]
    }
  }
}